# Standalone image for Home Assistant Container / Core installs (no add-on support).
# Built by docker-compose.yml in the repository root.
FROM python:3.12-alpine

RUN apk add --no-cache tzdata \
 && pip install --no-cache-dir flask==3.1.0 waitress==3.0.2

COPY app /app
WORKDIR /app

ENV DATA_DIR=/data PORT=8099 PYTHONUNBUFFERED=1
VOLUME /data
EXPOSE 8099
CMD ["python3", "/app/server.py"]
